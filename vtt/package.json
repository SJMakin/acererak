{
  "name": "lychgate-vtt",
  "version": "0.1.0",
  "description": "Decentralized TTRPG Virtual Tabletop",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "npm run test:unit",
    "test:unit": "cross-env PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --project=unit",
    "test:e2e": "playwright test --project=chromium --project=firefox",
    "test:e2e:ai": "cross-env RUN_PAID_AI_TESTS=1 playwright test tests/e2e/ai-image-generation.spec.ts --project=ai",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:join": "playwright test tests/e2e/join-game.spec.ts --headed",
    "test:e2e:deployed": "cross-env TEST_URL=https://lychgate.sammak.in playwright test tests/e2e/join-game.spec.ts --headed"
  },
  "dependencies": {
    "@mantine/core": "^7.11.0",
    "@mantine/hooks": "^7.11.0",
    "@mantine/notifications": "^7.17.8",
    "@tabler/icons-react": "^3.36.1",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/suggestion": "^3.29.2",
    "@use-gesture/react": "^10.3.1",
    "@trystero-p2p/torrent": "0.25.3",
    "dexie": "^4.0.4",
    "konva": "^9.3.6",
    "nanoid": "^6.0.1",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "xsai": "^0.4.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.15.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.5.2",
    "vite": "^8.2.1"
  }
}
